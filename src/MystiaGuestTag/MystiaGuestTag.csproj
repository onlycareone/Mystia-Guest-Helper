<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 游戏自带 coreclr 为 .NET 6.0.7（BepInEx/dotnet/Microsoft.NETCore.App.deps.json），插件必须同目标框架 -->
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MystiaGuestTag</AssemblyName>
    <RootNamespace>MystiaGuestTag</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.0</Version>

    <!-- 游戏安装目录。不写死本机路径：优先 -p:GameDir=...，其次环境变量 TOUHOU_GAME_DIR；
         两者都没给时，下面的 ValidateGameDir 目标会给出可读的报错和使用方法。 -->
    <GameDir Condition="'$(GameDir)'==''">$(TOUHOU_GAME_DIR)</GameDir>
    <BepInExDir Condition="'$(GameDir)'!=''">$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <!-- 没配 GameDir 时先给出人话提示，而不是一屏「找不到引用」的编译错误 -->
  <Target Name="ValidateGameDir" BeforeTargets="ResolveAssemblyReferences;ResolveProjectReferences;BeforeBuild">
    <Error Condition="'$(GameDir)' == ''"
           Text="没有配置游戏目录。用法：dotnet build -c Release -p:GameDir=&quot;你的游戏目录&quot;（或先设置环境变量 TOUHOU_GAME_DIR）。这里的「游戏目录」指 Touhou Mystia Izakaya.exe 所在的那层，里面应有 BepInEx\core 与 BepInEx\interop。" />
    <Error Condition="'$(GameDir)' != '' and !Exists('$(GameDir)/BepInEx/core')"
           Text="GameDir=&quot;$(GameDir)&quot; 里没有 BepInEx\core：请确认这是游戏根目录，并且已经至少启动过一次游戏（BepInEx 首次运行才会生成 core/interop）。" />
  </Target>

  <ItemGroup>
    <!-- BepInEx 6 IL2CPP 核心运行时（游戏目录自带，不随插件分发） -->
    <Reference Include="$(BepInExDir)\core\*.dll">
      <Private>false</Private>
    </Reference>
    <!-- 游戏自带 coreclr 运行时里的 System.Text.Json（v1.3.0 读本地 JSON 用，不随插件分发） -->
    <Reference Include="System.Text.Json">
      <HintPath>$(GameDir)\dotnet\System.Text.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Il2CppInterop 生成的游戏互操作程序集（首次启动游戏后出现在 interop/） -->
    <Reference Include="$(BepInExDir)\interop\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 构建后自动部署到游戏插件目录（BepInEx 会递归加载 plugins 子目录） -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(BepInExDir)\plugins')">
    <MakeDir Directories="$(BepInExDir)\plugins\MystiaGuestTag" />
    <!-- 某些受限环境下 MSBuild 覆盖写入游戏目录会被拒（bash/PowerShell 复制正常），
         失败只警告不中断：用 tools/deploy.sh 兜底复制即可。 -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\MystiaGuestTag"
          ContinueOnError="WarnAndContinue" />
    <Message Text="部署目标: $(BepInExDir)\plugins\MystiaGuestTag（若上面有 Access denied 警告，请运行 tools/deploy.sh）" Importance="high" />
  </Target>

</Project>
